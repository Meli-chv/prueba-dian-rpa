# Opcional: API key de un servicio de resolución de captcha compatible con 2Captcha.
# Si se deja vacío, el robot usa validación automática del navegador y, si hace falta, ayuda manual.
CAPTCHA_API_KEY=
CAPTCHA_API_BASE=https://2captcha.com
# 1 = navegador sin ventana (Cloudflare suele exigir más captcha en este modo)
HEADLESS=0
