# NIT del emisor o receptor: el portal lo pide junto al CUFE y es la contraseña del PDF
DIAN_NIT=

# Opcional: servicio de resolución de captcha compatible con 2Captcha (capa 2)
CAPTCHA_API_KEY=
CAPTCHA_API_BASE=https://2captcha.com

# 1 = navegador sin ventana (Cloudflare pide más captcha en este modo)
HEADLESS=0

# Opcional: avisos de la corrida (webhook de Workflows de Teams y/o Incoming Webhook de Slack)
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
# 1 = avisar solo si la corrida termina PARCIAL o FALLA
NOTIFICAR_SOLO_ALERTAS=0

# Navegador: chrome (recomendado, el instalado), msedge o chromium
NAVEGADOR=chrome
